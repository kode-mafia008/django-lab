# environments
venv/
.venv/
env/

# python artefacts
__pycache__/
*.py[cod]
*.egg-info/

# secrets
.env
*.pem

# the database and user uploads
db.sqlite3
db.sqlite3-journal
media/

# collected static (generated by collectstatic)
staticfiles/

# editor and OS noise
.vscode/
.idea/
.DS_Store

# guides/: the per-day student lab sheets (README-day*.md) ARE tracked.
# The long-form trainer manual, its generated HTML, and the build script are
# not — the manual is written against the trainer-only catalog/ app below.
guides/*.html
guides/*.sh
guides/django-practical-lab.md

# Trainer-owned material: kept on the trainer's machine, deliberately not in
# the repo. These were tracked once, so ignoring them was not enough — they
# had to be untracked with `git rm --cached`. Anything re-added under these
# paths now needs `git add -f`, by design.
catalog/
seed.py
lab.css
.claude/

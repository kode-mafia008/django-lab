# environments
venv/
.venv/
env/

# python artefacts
__pycache__/
*.py[cod]
*.egg-info/

# secrets
.env
*.pem

# the database and user uploads
db.sqlite3
db.sqlite3-journal
media/

# collected static (generated by collectstatic)
staticfiles/

# editor and OS noise
.vscode/
.idea/
.DS_Store

# generated lab guides (the markdown sources in guides/ are tracked)
guides/*.html
guides/*.sh

# the catalog app is trainer-owned reference material.
# Note this ignores the CONTENTS (catalog/*), not the directory (catalog/) —
# git never descends into an excluded directory, so `catalog/` would make the
# negation below impossible.
catalog/*
# Schema history must stay in version control, or the models and the database
# silently diverge for anyone who clones this repo.
!catalog/migrations/

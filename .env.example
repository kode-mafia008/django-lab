# Copy to `.env` and fill in. `.env` itself is gitignored and must stay that way.
#
#   set -a; source .env; set +a       # bash / zsh: export everything in here
#
# Nothing in this file is a real secret — it is the *list* of secrets, which is
# the part that belongs in git.

# 1 on a laptop, 0 everywhere else. With DEBUG=0 an unhandled error shows a
# plain 500 page instead of a stack trace, your settings and your SQL.
DJANGO_DEBUG=1

# Required when DEBUG=0; the app refuses to start without it. Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated Host-header allowlist. A request whose Host is not on this
# list gets a 400 before it reaches any view.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
